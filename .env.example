# agentforce-probe secrets -- copy to `.env` and fill in. NEVER commit the real .env.
# Values are read into memory only; never printed, logged, or written to evidence.

# -- InternalCopilot (Agent API) path: External Client App, Client Credentials --
# Get these from Setup > App Manager > (your ECA) > Manage Consumer Details.
AGENTPROBE_SF_CONSUMER_KEY=
AGENTPROBE_SF_CONSUMER_SECRET=

# -- LLM-as-judge (InternalCopilot path only). Only needed if you use a live
#    API-key judge instead of the default Claude Code file-handoff. Set the one
#    matching --judge. --
AGENTPROBE_OPENAI_API_KEY=
AGENTPROBE_ANTHROPIC_API_KEY=
